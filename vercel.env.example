# Vercel import file example (NO REAL SECRETS)
# انسخ هذا الملف محليًا وغيّر القيم ثم استورده في Vercel.
# لا ترفعه إلى GitHub بعد وضع كلمة المرور.

NODE_ENV=production
BASE_URL=https://car-auction-sand.vercel.app

# بيانات قاعدة البيانات (يجب أن تكون صحيحة 100% في Vercel)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/database_name?retryWrites=true&w=majority
MONGO_URI_CARX=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/car-x?retryWrites=true&w=majority
MONGO_URI_HMCAR=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/car-auction?retryWrites=true&w=majority
MONGO_URI_PRODUCTION=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/car-auction?retryWrites=true&w=majority

# كلمة مرور قاعدة البيانات (للسكريبتات)
MONGODB_PASSWORD=ضع_هنا_كلمة_مرور_قوية
MONGO_PASSWORD=ضع_هنا_كلمة_مرور_قوية

# أسرار الجلسة والتوكن (غيّرها لقيم قوية وعشوائية - مطلوبة بدون قيمة افتراضية)
NEXTAUTH_SECRET=ضع_هنا_سلسلة_عشوائية_قوية_طويلة_بدون_قيمة_افتراضية
SESSION_SECRET=ضع_هنا_سلسلة_عشوائية_قوية
JWT_SECRET=ضع_هنا_سلسلة_عشوائية_قوية

# كلمات مرور الأدمن (للسكريبتات)
ADMIN_PASSWORD=ضع_هنا_كلمة_مرور_قوية_للأدمن
DEFAULT_ADMIN_PASSWORD=ضع_هنا_كلمة_مرور_قوية_افتراضية
SUPER_ADMIN_PASSWORD=ضع_هنا_كلمة_مرور_قوية_للسوبر_أدمن

# مفاتيح Web Push (للإشعارات)
VAPID_PUBLIC_KEY=ضع_هنا_المفتاح_العام_لـVAPID
VAPID_PRIVATE_KEY=ضع_هنا_المفتاح_الخاص_لـVAPID

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=ضع_هنا_إيميل_الخدمة
EMAIL_PASS=ضع_هنا_كلمة_مرور_التطبيق

# Cloudinary CDN
CLOUDINARY_CLOUD_NAME=ضع_هنا_اسم_السحابة
CLOUDINARY_API_KEY=ضع_هنا_مفتاح_API
CLOUDINARY_API_SECRET=ضع_هنا_السر_الخاص

# Redis Cache
REDIS_URL=redis://<redis_host>:6379
REDIS_HOST=localhost
REDIS_PORT=6379
KV_URL=
