# =========================================================================
# HM CAR / CAR X - Multi-Tenant Car Auction System
# DEFAULT BACKEND ENV TEMPLATE (.env.example)
# 
# Usage: Copy this template to `.env` or `.env.local` to start local development.
# =========================================================================
# انسخ هذا الملف إلى .env وعدّل القيم

# ── قاعدة البيانات ──
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=Cluster0
MONGO_URI_CARX=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/carx?retryWrites=true&w=majority
MONGO_URI_HMCAR=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/car-auction?retryWrites=true&w=majority

# ── المصادقة والأمان (مطلوب - غيّر القيم) ──
NEXTAUTH_SECRET=your-random-secret-min-32-chars
SESSION_SECRET=your-session-secret-min-32-chars
JWT_SECRET=your-jwt-secret-min-32-chars

# ── الأدمن ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
WHATSAPP_NUMBER=+967000000000

# ── أسعار الصرف ──
USD_TO_SAR=3.75
USD_TO_KRW=1300

# ── النظام ──
NODE_ENV=development
SYSTEM_VERSION=2.0.0

# ── الروابط ──
BASE_URL=http://localhost:4001
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4001/api
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Cloudinary (تخزين الصور) ──
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ── Email (SMTP) - اختياري ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Push Notifications - اختياري ──
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# ── Sentry (مراقبة الأخطاء) - اختياري ──
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ── WebSocket / Real-time ──
# للتطوير المحلي
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001
# للإنتاج: أضف رابط الخادم المستمر (Railway, Render, VPS)
# NEXT_PUBLIC_SOCKET_URL=https://your-backend.railway.app

# ── Tenant (Multi-Tenant) ──
# hmcar = نظام HM CAR | carx = نظام CAR X
NEXT_PUBLIC_TENANT_ID=hmcar

# ── Redis Caching - اختياري لكن موصى به ──
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Vercel Blob Storage - اختياري ──
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# ── NEXT_PUBLIC vars مخصصة للـ Frontend ──
# هذه تُضاف في لوحة Vercel لكل مشروع على حدة
NEXT_PUBLIC_VAPID_KEY=your-vapid-public-key-for-browser
# HM CAR Frontend (client-app):
#   NEXT_PUBLIC_API_URL=https://hmcar-system-two.vercel.app/api
#   NEXT_PUBLIC_SOCKET_URL=https://your-backend.railway.app
#   NEXT_PUBLIC_TENANT_ID=hmcar
# CAR X Frontend (carx-system):
#   NEXT_PUBLIC_API_URL=https://hmcar-system-two.vercel.app/api
#   NEXT_PUBLIC_SOCKET_URL=https://your-backend.railway.app
#   NEXT_PUBLIC_TENANT_ID=carx