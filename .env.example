# CAR X System Environment Variables
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# Application
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_APP_NAME=CAR X
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_WHATSAPP=+966XXXXXXXXX

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/carx_production?retryWrites=true&w=majority

# Authentication - Generate secure random secrets!
# Use this command to generate: openssl rand -hex 32
NEXTAUTH_SECRET=generate-a-strong-random-64-character-secret-here
NEXTAUTH_URL=https://your-domain.com

# Default Admin Account
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-strong-admin-password

# Currency Rates
USD_TO_SAR=3.75
USD_TO_KRW=1300

# Environment
NODE_ENV=production

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# API Keys (Optional)
NEXT_PUBLIC_VERCEL_ANALYTICS=true