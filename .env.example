# Multi-Tenant Car Auction System - Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit your actual .env file to git!

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URI_CARX=mongodb+srv://<username>:<password>@cluster.mongodb.net/carx?retryWrites=true&w=majority
MONGO_URI_HMCAR=mongodb+srv://<username>:<password>@cluster.mongodb.net/car-auction?retryWrites=true&w=majority
MONGO_URI_PRODUCTION=mongodb+srv://<username>:<password>@cluster.mongodb.net/production?retryWrites=true&w=majority

# Database Password (for scripts)
MONGODB_PASSWORD=your-db-password
MONGO_PASSWORD=your-db-password

# Authentication (REQUIRED - no default)
NEXTAUTH_SECRET=generate-a-strong-random-64-character-secret-here
SESSION_SECRET=generate-a-strong-random-session-secret-here
JWT_SECRET=generate-a-strong-random-jwt-secret-here

# Admin Passwords
ADMIN_PASSWORD=your-strong-admin-password
DEFAULT_ADMIN_PASSWORD=your-strong-admin-password
SUPER_ADMIN_PASSWORD=your-super-admin-password

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com
WHATSAPP_NUMBER=+966XXXXXXXXX

# Currency Exchange
USD_TO_SAR=3.75
USD_TO_KRW=1300

# System Configuration
NODE_ENV=development
SYSTEM_VERSION=2.0.0

# URLs & CORS
BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4001

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_VERCEL_ANALYTICS=true