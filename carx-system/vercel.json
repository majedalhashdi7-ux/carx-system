{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["cdg1"],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "X-Tenant-ID", "value": "carx" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hmcar-system-two.vercel.app/api/:path*"
    }
  ]
}
